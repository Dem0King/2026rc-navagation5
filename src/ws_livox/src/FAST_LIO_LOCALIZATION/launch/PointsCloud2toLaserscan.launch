<launch>
        <!-- run pointcloud_to_laserscan node -->
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">
        <remap from="cloud_in" to="/cloud_registered"/>

        <rosparam>
            target_frame: body_2d   # 将点云变换到车体坐标系，使 clearing/高度滤波跟随机器人
            transform_tolerance: 1.0  # 0.1 → 与代价地图一致，防止 TF 外推错误
            min_height: -0.28        # 向下多取一些，捕捉地面附近障碍物
            max_height: 0.35         # 抬高上限，捕捉 30~50cm 障碍物

            angle_min: -3.14159
            angle_max: 3.14159
            angle_increment: 0.0087
            scan_time: 0.1
            range_min: 0.3
            range_max: 30.0
            use_inf: true
            inf_epsilon: 1.0

            concurrency_level: 1
        </rosparam>
    </node>
</launch>
