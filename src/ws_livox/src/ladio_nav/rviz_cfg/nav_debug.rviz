Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Reference Frame: map
      Value: true
    - Alpha: 0.7
      Class: rviz/Map
      Name: 2D 栅格地图
      Topic: /prior_map
      Value: true
      Color Scheme: map
    - Alpha: 0.5
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: 0
      Axis Z: 0
      Channel Name: x
      Class: rviz/PointCloud2
      Color: 0; 200; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Name: PCD 3D 地图 /map
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.03
      Style: Flat Squares
      Topic: /map
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: 0
      Axis Z: 0
      Channel Name: x
      Class: rviz/PointCloud2
      Color: 255; 85; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Name: 当前扫描 /cur_scan_in_map
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.04
      Style: Flat Squares
      Topic: /cur_scan_in_map
      Use Fixed Frame: true
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0.5
      Value: true
    - Class: rviz/LaserScan
      Name: 激光 /scan
      Topic: /scan
      Size (m): 0.03
      Style: Points
      Color Transformer: AxisColor
      Queue Size: 50
      Value: true
    - Class: rviz/Path
      Name: 全局路径
      Topic: /move_base1/GlobalPlanner/plan
      Color: 255; 0; 0
      Line Width: 0.1
      Value: true
    - Class: rviz/Path
      Name: 局部路径
      Topic: /move_base1/TebLocalPlannerROS/local_plan
      Color: 0; 255; 0
      Line Width: 0.08
      Value: true
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: costmap
      Name: 全局代价地图
      Topic: /move_base1/global_costmap/costmap
      Value: true
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: costmap
      Name: 局部代价地图
      Topic: /move_base1/local_costmap/costmap
      Value: true
    - Class: rviz/Odometry
      Name: 定位 /localization
      Topic: /localization
      Shape: Arrow
      Color: 138; 226; 52
      Value: true
      Keep: 1
      Position Tolerance: 0.1
      Angle Tolerance: 1
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal  
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.57
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0.78
