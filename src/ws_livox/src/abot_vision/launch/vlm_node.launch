<launch>
    <arg name="video_device" default="/dev/ocr_cam" />

    <!-- 摄像头节点：必须先发图，vlm_node 才有图可处理 -->
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
        <param name="video_device" value="$(arg video_device)" />
        <param name="pixel_format" value="mjpeg" />
        <param name="image_width"  value="1280" />
        <param name="image_height" value="720" />
        <param name="framerate"    value="30" />
    </node>

    <!-- 视觉大模型识别节点 -->
    <node name="abot_vlm_node" pkg="abot_vision" type="vlm_node.py" output="screen" required="true">
        <!-- 调用AI模型Flag (初始值255表示空闲) -->
        <param name="im_flag" type="int" value="255" />
        <!-- 摄像头识别结果记忆时间 -->
        <param name="im_flag_memory_time" type="double" value="0.0" />
    </node>
</launch>
